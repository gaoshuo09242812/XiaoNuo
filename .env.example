# Copy non-secret settings into .env.local; never paste real API keys into this file.
# Actual credentials stay in the private .env.local file.
XIAONUO_ADMIN_TOKEN=
XIAONUO_USAGE_REGION=CN
XIAONUO_DEPLOYMENT_REGION=UNDECIDED
XIAONUO_MODEL_MODE=PAID_FIRST
XIAONUO_PRIMARY_PAID=deepseek
XIAONUO_NETWORK_CHAT_PROVIDER=local
XIAONUO_REMOTE_ENABLED=false
XIAONUO_ALLOW_PAID=false
# Example monthly cap. Set your own budget. CNY takes priority over USD.
XIAONUO_MONTHLY_BUDGET_CNY=20.00
# Blank remains unconfirmed and blocks paid calls. Use 0 only if you have no hosting cost.
XIAONUO_MONTHLY_SERVER_COST_CNY=
# Legacy USD fields retained for compatibility, not a second active CNY limit.
XIAONUO_MONTHLY_BUDGET_USD=5.00
# Blank means unknown, and blocks paid requests. Set the actual service cost later.
XIAONUO_MONTHLY_SERVER_COST_USD=
XIAONUO_MAX_OUTPUT_TOKENS=512
XIAONUO_TIMEOUT_SECONDS=30
# Optional development USB connection. Never scans or opens unspecified ports.
XIAONUO_USB_PORT=
XIAONUO_LOCAL_LLM_ENABLED=false
XIAONUO_LOCAL_MODEL=Qwen3-1.7B-Q8_0
XIAONUO_TTS_PROVIDER=kokoro_onnx
# Enables only bounded manual playback; Manual playback is limited to 8 seconds.
XIAONUO_DEVICE_SPEAKER_ENABLED=false

# Provider availability depends on usage region and account policy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
XIAONUO_OPENAI_REGION_APPROVED=false
GEMINI_API_KEY=
GEMINI_MODEL=
XIAONUO_GEMINI_REGION_APPROVED=false
XIAONUO_GEMINI_FREE_ACCOUNT_CONFIRMED=false

# Not approved for the current region and not verified for this account.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
XIAONUO_GROQ_REGION_APPROVED=false
XIAONUO_GROQ_FREE_ACCOUNT_CONFIRMED=false

# Default mainland candidate. Calls stay disabled until credentials, region and costs are confirmed.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
XIAONUO_DEEPSEEK_REGION_APPROVED=false
# Required to normalize CNY billing into the unchanged USD budget. No invented FX.
XIAONUO_CNY_TO_USD=
XIAONUO_FX_CHECKED_ON=

# Requires the separate owner preference and explicitly enabled audio gateway.
XIAONUO_COMPUTER_WAKE_ENABLED=false
